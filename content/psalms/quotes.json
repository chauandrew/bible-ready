[
  {
    "id": "psalms-1-q1",
    "book": "psalms",
    "chapter": 1,
    "verse": 1,
    "speakerId": "the-psalmist",
    "text": "Blessed is the man who walks not in the counsel of the wicked, nor stands in the way of sinners, nor sits in the seat of scoffers;",
    "citation": { "book": "psalms", "chapter": 1, "verses": "1" }
  },
  {
    "id": "psalms-8-q1",
    "book": "psalms",
    "chapter": 8,
    "verse": 1,
    "speakerId": "david",
    "text": "O LORD, our Lord, how majestic is your name in all the earth! You have set your glory above the heavens.",
    "citation": { "book": "psalms", "chapter": 8, "verses": "1" }
  },
  {
    "id": "psalms-19-q1",
    "book": "psalms",
    "chapter": 19,
    "verse": 1,
    "speakerId": "david",
    "text": "The heavens declare the glory of God, and the sky above proclaims his handiwork.",
    "citation": { "book": "psalms", "chapter": 19, "verses": "1" }
  },
  {
    "id": "psalms-22-q1",
    "book": "psalms",
    "chapter": 22,
    "verse": 1,
    "speakerId": "david",
    "text": "My God, my God, why have you forsaken me? Why are you so far from saving me, from the words of my groaning?",
    "citation": { "book": "psalms", "chapter": 22, "verses": "1" }
  },
  {
    "id": "psalms-23-q1",
    "book": "psalms",
    "chapter": 23,
    "verse": 1,
    "speakerId": "david",
    "text": "The LORD is my shepherd; I shall not want.",
    "citation": { "book": "psalms", "chapter": 23, "verses": "1" }
  },
  {
    "id": "psalms-32-q1",
    "book": "psalms",
    "chapter": 32,
    "verse": 1,
    "speakerId": "david",
    "text": "Blessed is the one whose transgression is forgiven, whose sin is covered.",
    "citation": { "book": "psalms", "chapter": 32, "verses": "1" }
  },
  {
    "id": "psalms-46-q1",
    "book": "psalms",
    "chapter": 46,
    "verse": 1,
    "speakerId": "sons-of-korah",
    "text": "God is our refuge and strength, a very present help in trouble.",
    "citation": { "book": "psalms", "chapter": 46, "verses": "1" }
  },
  {
    "id": "psalms-51-q10",
    "book": "psalms",
    "chapter": 51,
    "verse": 10,
    "speakerId": "david",
    "text": "Create in me a clean heart, O God, and renew a right spirit within me.",
    "citation": { "book": "psalms", "chapter": 51, "verses": "10" }
  },
  {
    "id": "psalms-90-q12",
    "book": "psalms",
    "chapter": 90,
    "verse": 12,
    "speakerId": "moses",
    "text": "So teach us to number our days that we may get a heart of wisdom.",
    "citation": { "book": "psalms", "chapter": 90, "verses": "12" }
  },
  {
    "id": "psalms-119-q105",
    "book": "psalms",
    "chapter": 119,
    "verse": 105,
    "speakerId": "the-psalmist",
    "text": "Your word is a lamp to my feet and a light to my path.",
    "citation": { "book": "psalms", "chapter": 119, "verses": "105" }
  },
  {
    "id": "psalms-100-q1",
    "book": "psalms",
    "chapter": 100,
    "verse": 1,
